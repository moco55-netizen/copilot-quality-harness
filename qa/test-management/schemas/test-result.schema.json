{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "generatedAt", "status", "workflow", "steps", "coverage", "failures", "unexecuted", "unmeasured", "residualRisks"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed", "not-run"] },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "attempt", "branch", "commit", "startedAt"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" },
        "attempt": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "branch": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "reportTests", "unit", "m5Tests", "m2Tests", "m2Validation", "build", "lint", "playwrightInstall", "e2e"],
      "properties": {
        "install": { "$ref": "#/$defs/step" },
        "reportTests": { "$ref": "#/$defs/step" },
        "unit": { "$ref": "#/$defs/step" },
        "m5Tests": { "$ref": "#/$defs/step" },
        "m2Tests": { "$ref": "#/$defs/step" },
        "m2Validation": { "$ref": "#/$defs/step" },
        "build": { "$ref": "#/$defs/step" },
        "lint": { "$ref": "#/$defs/step" },
        "playwrightInstall": { "$ref": "#/$defs/step" },
        "e2e": { "$ref": "#/$defs/step" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "frontend"],
      "properties": {
        "backend": { "$ref": "#/$defs/coverage" },
        "frontend": { "$ref": "#/$defs/coverage" }
      }
    },
    "failures": { "type": "array", "items": { "type": "string" } },
    "unexecuted": { "type": "array", "items": { "type": "string" } },
    "unmeasured": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "reason"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "residualRisks": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "outcome"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["success", "failure", "cancelled", "skipped", "not-run"] }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "thresholdPercent", "metrics", "reason"],
      "properties": {
        "status": { "enum": ["measured", "not-measured"] },
        "path": { "type": "string", "minLength": 1 },
        "thresholdPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "metrics": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["statements", "branches", "functions", "lines"],
              "properties": {
                "statements": { "$ref": "#/$defs/coverageMetric" },
                "branches": { "$ref": "#/$defs/coverageMetric" },
                "functions": { "$ref": "#/$defs/coverageMetric" },
                "lines": { "$ref": "#/$defs/coverageMetric" }
              }
            }
          ]
        },
        "reason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "measured" } } },
          "then": { "properties": { "metrics": { "type": "object" }, "reason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "not-measured" } } },
          "then": { "properties": { "metrics": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "coverageMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "total", "percent"],
      "properties": {
        "covered": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
